POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=newton
MINIO_ROOT_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me

# Without this, every agent call (chat, memory consolidation, study-plan extraction)
# falls back to the keyless EchoProvider. See infra/README.md.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Google Classroom data connector (app-managed, separate from Keycloak's Google login
# IdP -- same OAuth client though). Without these, GET /integrations/classroom/connect
# returns 503. See app/services/google_classroom.py.
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
