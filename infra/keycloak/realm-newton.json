{
  "realm": "newton",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "passwordPolicy": "length(8)",
  "bruteForceProtected": true,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "newton-api",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*", "http://127.0.0.1:58500/callback"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-newton-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "newton-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "student1",
      "enabled": true,
      "emailVerified": true,
      "email": "student1@example.test",
      "firstName": "Student",
      "lastName": "One",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "newton-dev", "temporary": false }
      ],
      "realmRoles": ["default-roles-newton"]
    }
  ]
}
