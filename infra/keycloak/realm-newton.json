{
  "realm": "newton",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "newton-api",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audience-newton-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "newton-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "student1",
      "enabled": true,
      "emailVerified": true,
      "email": "student1@example.test",
      "firstName": "Student",
      "lastName": "One",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "newton-dev", "temporary": false }
      ]
    }
  ]
}
